# VS Code Settings
.vscode/
**/.vscode/
# Note: If we agreed on shared team settings, we can comment out .vscode/

# passwords, API keys
.env

# Python virtual environment (search in any folder)
**/.venv/
**/venv/
**/ENV/

# Python cash
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Node/frontend dependencies and build outputs
**/node_modules/
**/dist/
**/build/
**/.vite/
**/.cache/

# Frontend local env variants
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Common frontend logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/drift_gate_local.log
docs/migration-012-gap-analysis.md
.gitignore
