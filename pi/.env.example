# Pi-side runtime env
# Copy to .env and fill in values appropriate for the deployment target.

# Server hostname (Tailscale MagicDNS preferred; mDNS as fallback for dev).
# Used by kitchen-frontend's nginx to proxy /api/, /agent/, /uploads/, /docs,
# and /openapi.json to the server.
SERVER_HOST=voice-chef-server

# Tailscale IP of the server. Required because Docker bridge networks don't
# resolve Tailscale MagicDNS — we inject a static /etc/hosts entry.
# Find it via `tailscale status` on the server, or `tailscale ip -4` on the server.
SERVER_TAILSCALE_IP=100.65.33.127

# Server published ports for backend (FastAPI), agent (pydantic-ai), and
# office-frontend (where unauthenticated kitchen users get redirected to log in).
# Match the server's docker-compose.yml host ports. Override if your server
# binds these services to different host ports.
SERVER_BACKEND_PORT=8000
SERVER_AGENT_PORT=8001
SERVER_OFFICE_PORT=8080

# faster-whisper model size:
#   tiny     — minimal accuracy, only for quick smoke tests
#   base     — passable accuracy
#   small    — good accuracy (current default)
#   medium   — very good accuracy
#   large-v3 — best accuracy
STT_MODEL=small

# Force a language code (e.g., en, de, fr) or leave blank for auto-detect.
STT_LANGUAGE=

# CPU only on the Pi (no GPU available)
STT_DEVICE=cpu
