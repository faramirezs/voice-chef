# Pi-side runtime env
# Copy to .env and fill in values appropriate for the deployment target.

# Server hostname (Tailscale MagicDNS preferred; mDNS as fallback for dev).
# Used by kitchen-frontend's nginx to proxy /api/, /agent/, /uploads/, /docs,
# and /openapi.json to the server.
SERVER_HOST=voice-chef-server

# Tailscale IP of the server. Required because Docker bridge networks don't
# resolve Tailscale MagicDNS — we inject a static /etc/hosts entry.
# Find it via `tailscale status` on the server, or `tailscale ip -4` on the server.
SERVER_TAILSCALE_IP=100.65.33.127

# Server published ports for backend (FastAPI), agent (pydantic-ai), and
# office-frontend (where unauthenticated kitchen users get redirected to log in).
# Match the server's docker-compose.yml host ports. Override if your server
# binds these services to different host ports.
SERVER_BACKEND_PORT=8000
SERVER_AGENT_PORT=8001
SERVER_OFFICE_PORT=8080

# faster-whisper model size:
#   tiny     — minimal accuracy, only for quick smoke tests
#   base     — passable accuracy
#   small    — good accuracy (current default)
#   medium   — very good accuracy
#   large-v3 — best accuracy
STT_MODEL=small

# Force a language code (e.g., en, de, fr) or leave blank for auto-detect.
STT_LANGUAGE=

# CPU only on the Pi (no GPU available)
STT_DEVICE=cpu

# ─── Kitchen-device auto-login ───────────────────────────────────────────────
# Credentials for a backend user with role='kitchen' that the kitchen-pi
# device authenticates as on startup. The kitchen kiosk is not bound to any
# specific person — it represents the device. These end up in /config.js
# served by the Pi's nginx (visible to anyone on the Pi's LAN/tailnet, so
# treat as low-trust kiosk credentials, not personal credentials).
#
# Provision once on the server side:
#   docker compose exec -T backend python <<PY
#   ...create user with role='kitchen' (see docs/kitchen-pi-design.md)
#   PY
KITCHEN_EMAIL=kitchen@kitchen.pi
KITCHEN_PASSWORD=change-me-strong-password

# ─── Wake-word service ───────────────────────────────────────────────────────
# Comma-separated openWakeWord pretrained models to load. The official set
# includes hey_jarvis, alexa, hey_mycroft, hey_rhasspy. Custom models live
# in the openWakeWord docs: https://github.com/dscripka/openWakeWord
WAKE_MODELS=hey_jarvis

# Detection threshold 0–1. Lower = more triggers (false positives), higher =
# fewer (false negatives). 0.5 is the upstream default.
WAKE_THRESHOLD=0.5

# Minimum gap between two wake events to debounce a single utterance from
# triggering multiple recordings.
WAKE_COOLDOWN_MS=1500

# Capture sample rate. openWakeWord requires 16000 Hz.
WAKE_SAMPLE_RATE=16000

# Optional sounddevice index/name override. Leave blank to use the default
# capture device (set via wireplumber/51-respeaker-default.conf). Run
# `python -m sounddevice` inside the wake container to see indices.
WAKE_DEVICE=
