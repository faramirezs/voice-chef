# Shared secret for agent→backend internal auth bypass.
# Only the agent service sends this header. Browser requests never do.
# Change to a long random string in production. openssl rand -base64 32
INTERNAL_SECRET=your-long-random-string-here

# Database env
POSTGRES_DB=recipe_db
POSTGRES_USER=recipe_user
POSTGRES_PASSWORD=recipe_pass123
DATABASE_URL=postgresql+psycopg://recipe_user:recipe_pass123@db:5432/recipe_db

# Backend env
SQL_ECHO=1
DEFAULT_TENANT_ID=0b796544-6414-4d62-8f1f-cd2f9f0ac0a0

# jwt secret
SECRET_KEY=super_secret_random_string_at_least_32_bytes

# Agent env
# Provider switch: nvidia | openrouter | openai
AGENT_PROVIDER=nvidia
AGENT_MODEL=meta/llama-3.3-70b-instruct

# Openrouter free models
#AGENT_MODEL=google/gemma-4-31b-it:free
#AGENT_MODEL=minimax/minimax-m2.5:free
#AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#AGENT_MODEL=meta-llama/llama-3.3-70b-instruct:free


#AGENT_MODEL=minimax/minimax-m2.5
#AGENT_MODEL=stepfun/step-3.5-flash
#AGENT_MODEL=deepseek-ai/deepseek-v4-flash
#AGENT_MODEL=meta/llama-3.3-70b-instruct

# Optional override. If empty, agent.py uses provider defaults:
# nvidia -> https://integrate.api.nvidia.com/v1
# openrouter -> https://openrouter.ai/api/v1
# openai -> https://api.openai.com/v1
AGENT_BASE_URL=

# Preferred unified key variable (works for any provider)
AGENT_API_KEY=

# Optional provider-specific fallback keys (used only if AGENT_API_KEY is empty)
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

AGENT_DEBUG_STREAM=0

# Nginx proxy / SSL
# Domain name or IP address used in the self-signed certificate's CN and SAN.
# Default is localhost.
DOMAIN_NAME=localhost

# Frontend env
# URL for the kitchen display link in office frontend.
# In production behind shared proxy: https://<host>/kitchen/
# In local dev: http://localhost:5174 (docker-compose.override handles this)
VITE_KITCHEN_URL=http://localhost:8082

# STT (Speech-to-Text) env
STT_MODEL=base
STT_LANGUAGE=
STT_DEVICE=cpu
