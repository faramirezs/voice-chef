server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA routing — all non-file requests go to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API traffic to FastAPI
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy agent traffic to Agent service.
    # Agent uses AG-UI's SSE streaming, so disable buffering and extend
    # timeouts. The previous WebSocket upgrade headers were inert for SSE
    # (and harmful: Connection: upgrade with empty Upgrade target confuses
    # some intermediaries).
    location /agent/ {
        proxy_pass http://${AGENT_HOST}:${AGENT_PORT}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # SSE essentials: flush each chunk to the client immediately, allow
        # long-running thinking, never cache.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        # Belt-and-braces hint to any downstream proxies (and to nginx itself
        # via the X-Accel-Buffering convention) to disable response buffering.
        proxy_set_header X-Accel-Buffering no;
    }

    # Proxy STT traffic to STT service
    # NOTE: stt is always local in both server-side and Pi-side compose
    # networks, so no templating needed here.
    location /stt/ {
        proxy_pass http://stt:8002/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy wake-word events to the wake service.
    # The /events endpoint is an SSE stream — same buffering/timeout posture
    # as /agent/.
    #
    # The wake service only ships in the Pi compose; on the server compose
    # the `wake` hostname doesn't exist. We use the variable form of
    # proxy_pass with Docker's embedded DNS resolver (127.0.0.11) so nginx
    # defers resolution until a request actually arrives — without this,
    # nginx would refuse to start on the server side ("host not found in
    # upstream wake"). When no wake service is present, /wake/* returns
    # 502 and the SPA's EventSource simply reconnects forever, which is
    # the right inert behaviour.
    location /wake/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        # Variable-form proxy_pass doesn't rewrite the URI for us, so strip
        # the /wake/ prefix explicitly. /wake/events -> /events.
        rewrite ^/wake/(.*)$ /$1 break;
        set $wake_upstream "wake:8004";
        proxy_pass http://$wake_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
        proxy_set_header X-Accel-Buffering no;
    }

    # Proxy uploads to backend file storage
    location /uploads/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/uploads/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy Swagger docs and OpenAPI schema
    location /docs {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/docs;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /openapi.json {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/openapi.json;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Cache static assets aggressively
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Never cache index.html (contains new asset hashes after deploy)
    location = /index.html {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_vary on;
}
